ive;z-index:2;font-family:'Fraunces',serif;font-size:1.5rem;color:#fff;text-shadow:0 1px 12px rgba(0,0,0,.4)}.oc-root .shopcard a{position:absolute;inset:0;z-index:3}.oc-root .colorband{background:#ffec8e;text-align:center;padding:clamp(56px,10vw,104px) 24px}.oc-root .colorband h2{font-family:'Fraunces',Georgia,serif;font-weight:400;font-size:clamp(40px,8.5vw,92px);color:#000;line-height:1;letter-spacing:-.01em;margin:0}.oc-root .colorband em{font-style:italic;color:#4f7953}.oc-root .trust{background:var(--ink-oat);text-align:center;padding:60px 0}.oc-root .trust__badges{display:flex;justify-content:center;align-items:center;gap:clamp(16px,5vw,64px);flex-wrap:wrap}.oc-root .trust__badges img{width:clamp(92px,12vw,132px);height:auto}.oc-root footer{background:var(--ink-charcoal);color:var(--ink-oat);text-align:center;padding:40px 24px;font-family:'Space Mono',monospace;font-size:.72rem;letter-spacing:.08em}@media(max-width:860px){.oc-root .hero__grid,.oc-root .makers__grid{grid-template-columns:1fr}.oc-root .hero__media{min-height:52vh}.oc-root .hero__text{padding:56px 28px}.oc-root .steps,.oc-root .jgrid,.oc-root .shop__grid{grid-template-columns:1fr}.oc-root .steps{gap:44px}.oc-root section{padding:64px 0}}\n</style>\n<div class=\"oc-root\">\n<header class=\"hero\">\n  <div class=\"hero__grid\">\n    <div class=\"hero__text\">\n      <div class=\"hero__panel\">\n      <span class=\"eyebrow\">Inked by artists · Made for adventure</span>\n      <h1>Colorful by <em>nature</em>.</h1>\n      <p class=\"hero__sub\">Original artwork, drawn by hand, then built into a shoe you can actually live in — designed for your everyday adventures.</p>\n      <div class=\"hero__cta\">\n        <a class=\"btn\" href=\"/collections/best-sellers\">Shop the collection</a>\n        <a class=\"btn btn--ghost\" href=\"#craft\">See how they're made</a>\n      </div>\n      </div>\n    </div>\n    <div class=\"hero__media\"><div class=\"ph\" data-label=\"Hero video\"><video autoplay muted loop playsinline poster=\"https://inkkas.com/cdn/shop/files/preview_images/1f82743de7da4ed0afa07d87cf3b1291.thumbnail.0000000000_690x.jpg?v=1752690492\" src=\"https://cdn.shopify.com/videos/c/o/v/e3421e5d71dc4665895056cb68aa71c2.mp4\"></video></div></div>\n  </div>\n</header>\n\n<section class=\"craft\" id=\"craft\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"eyebrow\">The Inkkas Journey</span>\n      <h2>From Sketch to Step</h2>\n      <p>Three stages take a pair from a blank page to your feet.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"ph step__img\" data-label=\"art\"><video autoplay muted loop playsinline src=\"https://cdn.shopify.com/videos/c/o/v/eca3a749b58b43e4b714ce704c03b73f.webm\"></video></div>\n        <span class=\"step__n\">Step 01</span><h3>It All Starts with Art</h3>\n        <p>Every pair of Inkkas begins as a hand-inked work of art, created to spark joy, connection, and inspiration. Each design is inspired by the natural world — its colors, textures, and rhythms: florals, landscapes, animals, and the organic patterns that draw us in.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"ph step__img\" data-label=\"making\"><img src=\"https://inkkas.com/cdn/shop/files/making_of_the_joggers-ezgif.com-optiwebp.webp?v=1764878270\" alt=\"Making the shoe by hand\"></div>\n        <span class=\"step__n\">Step 02</span><h3>Beauty Meets Function</h3>\n        <p>Each sketch is transformed into a handcrafted shoe where artistry meets engineering. Using high-quality, responsible materials and time-honored techniques, we build comfort into every detail — cushioned insoles, supportive soles, and a fit that feels made just for you.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"ph step__img\" data-label=\"worn\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/NAIA-SLIP-ON-SS260308-MODEL-EPI_5610-ezgif.com-jpg-to-webp-converter.webp?v=1774363094\" alt=\"Model wearing Inkkas Naia slip-ons\"></div>\n        <span class=\"step__n\">Step 03</span><h3>Made to be Loved</h3>\n        <p>Step into a pair and expect that unmistakable confidence that comes from walking in something one-of-a-kind — shoes that feel good for the soul (and the sole), good for the planet, and made to spark smiles along the way.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"makers\">\n  <div class=\"wrap\">\n    <div class=\"makers__grid\">\n      <div>\n        <span class=\"eyebrow\">The hands behind them</span>\n        <h2>Handcrafting since 2012.</h2>\n        <p>Our shoes are 100% handmade in Latin America with our longtime partners &amp; ethical shoemakers. We use authentic textiles sourced globally and our distinctive designs are inspired by nature around the world.</p>\n        <div class=\"meta\">Small-batch · Fair supply chain · Independent</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"teaser\">\n  <div class=\"wrap\">\n    <div>\n      <span class=\"eyebrow\">Walking the Talk</span>\n      <h3>Every pair also plants a tree. 500,000+ and counting.</h3>\n    </div>\n    <a class=\"btn btn--ghost\" href=\"/pages/our-impact\">See Our Impact →</a>\n  </div>\n</section>\n\n<section class=\"journal\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"eyebrow\">Go Deeper</span><h2>The Inkkas Journal</h2></div>\n    <div class=\"jgrid\">\n      <div class=\"jcard\"><div class=\"ph jcard__img\" data-label=\"journal\"><img src=\"https://inkkas.com/cdn/shop/articles/Janine-_Artist_Feature-cover_922625da-847e-49de-ae14-a313db750fc3_320x320_crop_center.jpg?v=1784157411\" alt=\"Artist feature\"></div><span class=\"eyebrow\">Artist Spotlight</span><h3>Meet the artists behind the ink</h3><p>The people and places that shape each design.</p></div>\n      <div class=\"jcard\"><div class=\"ph jcard__img\" data-label=\"journal\"><img src=\"https://inkkas.com/cdn/shop/articles/Wednesday_Walk_Issue_5_Content-Cover_329abed1-153d-43f3-bc5f-3627efc43804_320x320_crop_center.jpg?v=1786507801\" alt=\"Wednesday Walk\"></div><span class=\"eyebrow\">Field Notes</span><h3>Where the season is taking us</h3><p>Travel-inspired stories and styling.</p></div>\n      <div class=\"jcard\"><div class=\"ph jcard__img\" data-label=\"journal\"><img src=\"https://inkkas.com/cdn/shop/articles/Wednesday_Walk_Issue_4_MAY_COVER-compress_e9f2d019-86a0-4c9f-be82-2a0aff30ade7_320x320_crop_center.jpg?v=1784157392\" alt=\"Wednesday Walk May\"></div><span class=\"eyebrow\">Process</span><h3>Inside the workshop</h3><p>How a drawing becomes a shoe.</p></div>\n    </div>\n    <div style=\"text-align:center;margin-top:44px\"><a class=\"btn btn--ghost\" href=\"/blogs/inkkas-journal\">View all posts</a></div>\n  </div>\n</section>\n\n\n<section class=\"trust\">\n  <div class=\"wrap\">\n    <div class=\"trust__badges\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/3_1.png?v=1779992083\" alt=\"Inked by artists — original artistry\" width=\"190\" height=\"190\" loading=\"lazy\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/1_1.png?v=1779992083\" alt=\"Over 10,000 5-star reviews\" width=\"190\" height=\"190\" loading=\"lazy\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/5_1.png?v=1779992083\" alt=\"Global design — authentic textiles\" width=\"190\" height=\"190\" loading=\"lazy\">\n    </div>\n  </div>\n</section>\n\n<section class=\"shop\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"eyebrow\">Now the fun part</span><h2>Shop the art</h2></div>\n    <div class=\"shop__grid\">\n      <div class=\"shopcard\"><div class=\"ph\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/GIF-JOYA_VEGAN_TREKK_BOOT-WALK.webp?v=1783627766\" alt=\"Women's\"></div><span>Women's</span><a href=\"/collections/womens-collection-all-shoes\" aria-label=\"Shop Women's\"></a></div>\n      <div class=\"shopcard\"><div class=\"ph\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/NAIA-BUCKLESANDAL-SS261217-JOYA-VEGAN-TREKKBOOT-SS261022-SILVAN-TREKKBOOT-SS261023-NAIA-SLIPON-SS260308-JOYA-VEGAN-TENNIS-SS260201-MODEL-DOG-GROUP-IMG_1481.jpg?v=1774363027\" alt=\"New\"></div><span>New Arrivals</span><a href=\"/collections/new-arrivals\" aria-label=\"Shop New Arrivals\"></a></div>\n      <div class=\"shopcard\"><div class=\"ph\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/ScreenShot2024-04-08at2.13.04PM.png?v=1759884243\" alt=\"Bestsellers\"></div><span>Bestsellers</span><a href=\"/collections/best-sellers\" aria-label=\"Shop Bestsellers\"></a></div>\n    </div>\n  </div>\n</section>\n</div>"
      }
