mp(1.5rem,2.6vw,2.1rem);max-width:24ch}.oc-root .shop{background:var(--ink-green-deep)}.oc-root .shop .sec-head h2{color:#fff}.oc-root .shop .sec-head .eyebrow{color:#DDE7CE}.oc-root .shop__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px}.oc-root .shopcard{position:relative;aspect-ratio:4/5;border-radius:6px;overflow:hidden;display:flex;align-items:flex-end;padding:24px}.oc-root .shopcard .ph{position:absolute;inset:0;border-radius:0}.oc-root .shopcard span{position:relative;z-index:2;font-family:'Fraunces',serif;font-size:1.5rem;color:#fff;text-shadow:0 1px 12px rgba(0,0,0,.4)}.oc-root .shopcard a{position:absolute;inset:0;z-index:3}.oc-root .polaroids{background:#fff;text-align:center}.oc-root .polaroids .single-polaroid{margin-top:44px}.oc-root .polaroids .single-polaroid img{width:100%;height:auto;border-radius:4px;display:block}.oc-root .polaroids .row{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:44px}.oc-root .polaroid{background:#fff;padding:12px 12px 34px;box-shadow:0 8px 24px rgba(51,80,47,.12);border-radius:2px}.oc-root .polaroid:nth-child(odd){transform:rotate(-2deg)}.oc-root .polaroid:nth-child(even){transform:rotate(1.8deg)}.oc-root .polaroid .ph{aspect-ratio:3/4;border-radius:0}.oc-root footer{background:var(--ink-charcoal);color:var(--ink-oat);text-align:center;padding:40px 24px;font-family:'Space Mono',monospace;font-size:.72rem;letter-spacing:.08em}@media(max-width:860px){.oc-root .hero__grid,.oc-root .feat{grid-template-columns:1fr}.oc-root .feat{gap:28px;margin-bottom:8px}.oc-root .feat--rev .feat__img{order:0}.oc-root .hero__media{min-height:46vh}.oc-root .hero__text{padding:56px 28px}.oc-root .statgrid,.oc-root .shop__grid{grid-template-columns:1fr}.oc-root .polaroids .row{grid-template-columns:1fr 1fr;gap:14px}.oc-root section{padding:64px 0}}\n</style>\n<div class=\"oc-root\">\n<header class=\"hero\">\n  <div class=\"hero__grid\">\n    <div class=\"hero__text\">\n      <span class=\"eyebrow\">One Shoe · One Tree™</span>\n      <h1>Every pair <em>plants a tree.</em></h1>\n      <div class=\"stat\">500,000+</div>\n      <div class=\"stat-label\">Trees planted &amp; counting</div>\n      <div class=\"hero__cta\">\n        <a class=\"btn\" href=\"/collections/vegan-products\">Shop &amp; plant a tree</a>\n        <a class=\"btn btn--ghost-light\" href=\"#tree\">How it works</a>\n      </div>\n    </div>\n    <div class=\"hero__media\"><div class=\"ph ph--dark\" data-label=\"tree planting\"><img src=\"https://inkkas.com/cdn/shop/files/Planting-trees_690x460_crop_center.jpg?v=1614373072\" alt=\"Tree planting\"></div></div>\n  </div>\n</header>\n\n\n<section class=\"onetree\" id=\"tree\">\n  <div class=\"wrap\">\n    <div class=\"feat\">\n      <div class=\"ph feat__img\" data-label=\"tree counter\" style=\"aspect-ratio:1100/526;background:var(--ink-green-soft)\"><img src=\"https://inkkas.com/cdn/shop/files/Tree-Number-12.2025-curved_1100x526_crop_center.gif?v=1766515934\" alt=\"Trees planted counter\" style=\"object-fit:contain\"></div>\n      <div>\n        <span class=\"eyebrow\">Reforestation</span>\n        <h2>One shoe, one tree — for every single purchase.</h2>\n        <p>For every purchase, we plant one tree through our OneShoeOneTree™ program with trees.org — supporting reforestation, biodiversity, and climate resilience.</p>\n        <div class=\"pills\"><span class=\"pill\">Reforestation</span><span class=\"pill\">Biodiversity</span><span class=\"pill\">Climate resilience</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section>\n  <div class=\"wrap\">\n    <div class=\"feat feat--rev\">\n      <div class=\"ph feat__img\" data-label=\"making\"><img src=\"https://inkkas.com/cdn/shop/files/making_of_the_joggers-ezgif.com-optiwebp.webp?v=1764878270\" alt=\"Small-batch making\"></div>\n      <div>\n        <span class=\"eyebrow\">Made the right way</span>\n        <h2>Handcrafted, small-batch, ethically made.</h2>\n        <p>Our shoes are 100% handmade in Latin America using authentic textiles sourced globally — produced in small batches through a fair supply chain, not a factory line.</p>\n        <p>Staying independent lets us keep those standards — and keep the families who craft our shoes, and the people behind the brand, supported and at the center of everything we do.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"s4s-band\">\n  <div class=\"wrap\">\n    <div class=\"s4s\">\n      <span class=\"eyebrow\">Second Life</span>\n      <h2>Shoes that keep going.</h2>\n      <p>We partner with Soles4Souls to refurbish and redistribute shoes — keeping them out of landfills and on the feet of people who need them.</p>\n      <div class=\"pills\"><span class=\"pill\">Refurbish</span><span class=\"pill\">Donate</span><span class=\"pill\">Divert waste</span></div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"stats\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"eyebrow\">The Receipts</span><h2>Impact by the numbers</h2></div>\n    <div class=\"statgrid\">\n      <div><div class=\"n\">500K+</div><div class=\"l\">Trees planted</div></div>\n      <div><div class=\"n\">1 : 1</div><div class=\"l\">Tree per purchase</div></div>\n      <div><div class=\"n\">2012</div><div class=\"l\">Handcrafting since</div></div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"teaser\">\n  <div class=\"wrap\">\n    <div>\n      <span class=\"eyebrow\">Where it starts</span>\n      <h3>Every tree begins with a hand-inked work of art — and every work of art begins with nature.</h3>\n    </div>\n    <a class=\"btn btn--ghost\" href=\"/pages/about\">← See Our Craft</a>\n  </div>\n</section>\n\n\n<section class=\"shop\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"eyebrow\">Do good, look good</span><h2>Shop &amp; plant a tree</h2></div>\n    <div class=\"shop__grid\">\n      <div class=\"shopcard\"><div class=\"ph ph--dark\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/SARAS-VEGAN-TREKKBOOT-AW251017-FLAT-RTSS1175_5caf08fb-6041-45f0-8694-d4c3383c19cc-ezgif.com-jpg-to-webp-converter.webp?v=1784081964\" alt=\"Vegan\"></div><span>100% Vegan</span><a href=\"/collections/vegan-products\" aria-label=\"Shop Vegan\"></a></div>\n      <div class=\"shopcard\"><div class=\"ph ph--dark\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/GIF-JOYA_VEGAN_TREKK_BOOT-WALK.webp?v=1783627766\" alt=\"Women's\"></div><span>Women's</span><a href=\"/collections/womens-collection-all-shoes\" aria-label=\"Shop Women's\"></a></div>\n      <div class=\"shopcard\"><div class=\"ph ph--dark\"><img src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/ScreenShot2024-04-08at2.13.04PM.png?v=1759884243\" alt=\"Bestsellers\"></div><span>Bestsellers</span><a href=\"/collections/best-sellers\" aria-label=\"Shop Bestsellers\"></a></div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"polaroids\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"eyebrow\">Out in the world</span><h2>Made for adventure.</h2></div>\n    <div class=\"single-polaroid\"><img src=\"https://inkkas.com/cdn/shop/files/DesertPolaroid15_1440x554_crop_center.jpg?v=1779983624\" alt=\"Inkkas out in the world\"></div>\n  </div>\n</section>\n</div>"
