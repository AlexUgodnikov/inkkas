    "custom_liquid_4xM4cK": {
      "type": "custom-liquid",
      "name": "Custom Liquid: Belief Line",
      "settings": {
        "custom_liquid": "<section class=\"ink-belief\">\n  <div class=\"ink-belief__inner\">\n    <p class=\"ink-belief__text\">\n      We make bold footwear worth celebrating &mdash; <em>hand-inked</em> art &amp; <em>handcrafted</em> comfort combine for your <em>happiest</em> adventures.<img class=\"ink-belief__suninline\" src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/inkkas-belief-sun.png?v=1786676824\" alt=\"\" aria-hidden=\"true\">\n    </p>\n    <a class=\"ink-belief__link\" href=\"/collections/best-sellers\">See for yourself <span aria-hidden=\"true\">&rarr;</span></a>\n  </div>\n  <img class=\"ink-belief__sun\" src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/inkkas-belief-sun.png?v=1786676824\" alt=\"\" aria-hidden=\"true\">\n</section>\n<style>\n  .ink-belief{\n    position: relative;\n    padding: clamp(28px, 5vw, 56px) 20px;\n    text-align: center;\n    background: #f5efeb;\n    overflow: hidden;\n  }\n  .ink-belief__inner{ max-width: 720px; margin: 0 auto; }\n  .ink-belief__text{\n    font-family: 'Fraunces', Georgia, serif;\n    font-weight: 500;\n    font-size: clamp(18px, 2.2vw, 26px);\n    line-height: 1.3;\n    letter-spacing: .01em;\n    color: #1A1A1A;\n    margin: 0 0 clamp(14px, 2vw, 20px);\n  }\n  .ink-belief__text em{ font-style: italic; color: #C15F3C; }\n  .ink-belief__link{\n    display: inline-block;\n    font-family: 'Space Mono', ui-monospace, monospace;\n    font-size: 13px; font-weight: 700; letter-spacing: .14em;\n    text-transform: uppercase; color: #1A1A1A; text-decoration: none;\n    border-bottom: 1.5px solid currentColor; padding-bottom: 3px;\n    transition: opacity .2s ease;\n  }\n  .ink-belief__link:hover{ opacity: .65; }\n  .ink-belief__sun{\n    position: absolute;\n    top: 50%;\n    right: clamp(18px, 5vw, 70px);\n    transform: translateY(-50%);\n    width: clamp(50px, 7vw, 82px);\n    height: auto;\n    pointer-events: none;\n  }\n  .ink-belief__suninline{ display: none; }\n  @media (max-width: 900px){\n    .ink-belief__sun{ display: none; }\n    .ink-belief__suninline{\n      display: inline-block;\n      width: 24px; height: 24px;\n      vertical-align: -5px;\n      margin-left: 6px;\n    }\n  }\n  @media (max-width: 480px){\n    .ink-belief__link{ font-size: 12px; letter-spacing: .12em; }\n  }\n</style>"
      }
