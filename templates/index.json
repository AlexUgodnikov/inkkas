    "quiz_custom": {
      "type": "custom-liquid",
      "name": "Custom liquid: quiz",
      "settings": {
        "custom_liquid": "<div class=\"ink-quiz\">\n  <div class=\"ink-quiz__text\">\n    <p class=\"ink-quiz__eyebrow\">find your solemate</p>\n    <h2 class=\"ink-quiz__title\">Not sure where to start?</h2>\n    <p class=\"ink-quiz__sub\">Answer 5 quick questions and we'll find your perfect pair.</p>\n  </div>\n  <a href=\"/pages/quiz\" class=\"ink-quiz__btn\">Take the quiz &rarr;</a>\n</div>\n<style>\n.ink-quiz{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;background:#ffec8e;padding:48px 56px}\n.ink-quiz__eyebrow{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C15F3C;margin:0 0 8px}\n.ink-quiz__title{font-family:'Fraunces',Georgia,serif;font-weight:400;font-size:34px;line-height:1.05;color:#1A1A1A;margin:0 0 6px}\n.ink-quiz__sub{font-family:'Manrope',system-ui,sans-serif;color:#4A443B;font-size:15px;margin:0}\n.ink-quiz__btn{flex:0 0 auto;background:#1A1A1A;color:#ffffff;text-decoration:none;font-family:'Manrope',system-ui,sans-serif;font-weight:700;padding:15px 30px;border-radius:40px;font-size:14px;white-space:nowrap}\n@media(max-width:749px){.ink-quiz{flex-direction:column;align-items:flex-start;text-align:left;padding:36px 24px;gap:18px}.ink-quiz__title{font-size:27px}}\n</style>"
      }
    },
    "custom_liquid_FDaiXD": {
      "type": "custom-liquid",
      "name": "Custom liquid: hand-inked",
      "settings": {
        "custom_liquid": "<div class=\"ink-craft\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n    <filter id=\"ink-sketch\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.03\" numOctaves=\"2\" seed=\"7\" result=\"n\"/>\n      <feDisplacementMap in=\"SourceGraphic\" in2=\"n\" scale=\"2.2\" xChannelSelector=\"R\" yChannelSelector=\"G\"/>\n    </filter>\n  </defs></svg>\n  <div class=\"ink-craft__text\">\n    <p class=\"ink-craft__eyebrow\">since 2012</p>\n    <h2 class=\"ink-craft__title\">Step into your next <em>adventure.</em> </h2>\n    <p class=\"ink-craft__body\">Hand-drawn by independent artists and inspired by the beauty around us, every pair is ethically handcrafted in small batches—better for people and the planet.</p>\n    <div class=\"ink-craft__chips\">\n      <span>\n        <svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" filter=\"url(#ink-sketch)\"><circle cx=\"24\" cy=\"24\" r=\"7\"/><line x1=\"24\" y1=\"13\" x2=\"24\" y2=\"7\"/><line x1=\"24\" y1=\"35\" x2=\"24\" y2=\"41\"/><line x1=\"13\" y1=\"24\" x2=\"7\" y2=\"24\"/><line x1=\"35\" y1=\"24\" x2=\"41\" y2=\"24\"/><line x1=\"16.2\" y1=\"16.2\" x2=\"12.3\" y2=\"12.3\"/><line x1=\"31.8\" y1=\"16.2\" x2=\"35.7\" y2=\"12.3\"/><line x1=\"16.2\" y1=\"31.8\" x2=\"12.3\" y2=\"35.7\"/><line x1=\"31.8\" y1=\"31.8\" x2=\"35.7\" y2=\"35.7\"/></svg>\n        colorful by nature\n      </span>\n      <span>\n        <svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" filter=\"url(#ink-sketch)\"><line x1=\"13\" y1=\"35\" x2=\"32\" y2=\"16\"/><circle cx=\"33.5\" cy=\"14.5\" r=\"2.2\"/><path d=\"M33.5 14.5 C 41 18, 39 27, 30 26 C 24 25.5, 24 33, 30 35\"/></svg>\n        ethically crafted\n      </span>\n      <span>\n        <svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" filter=\"url(#ink-sketch)\"><path d=\"M14 42 H34\"/><path d=\"M24 42 V21\"/><path d=\"M24 30 C 18 31, 13 27, 13 20 C 20 20, 24 24, 24 30 Z\"/><path d=\"M24 26 C 30 27, 35 23, 35 16 C 28 16, 24 20, 24 26 Z\"/></svg>\n        500k+ trees planted\n      </span>\n    </div>\n    <a href=\"/pages/about\" class=\"ink-craft__link\">Our Story &rarr;</a>\n  </div>\n  <div class=\"ink-craft__imgwrap\">\n    <img class=\"ink-craft__img\" src=\"https://inkkas.com/cdn/shop/files/BLAKE-SLIP-ON-KL302333-MODELZOOM-ART-IMG_7673.jpg?v=1764879294\" alt=\"Artist sketching an original Inkkas design\" loading=\"lazy\">\n  </div>\n</div>\n<style>\n.ink-craft{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;background:#f5efeb;overflow:hidden}\n.ink-craft__text{padding:60px 56px}\n.ink-craft__eyebrow{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C15F3C;margin:0 0 12px}\n.ink-craft__title{font-family:'Fraunces',Georgia,serif;font-weight:400;font-size:38px;line-height:1.05;color:#1A1A1A;margin:0 0 16px}\n.ink-craft__title em{font-style:italic;color:#C15F3C}\n.ink-craft__body{font-family:'Manrope',system-ui,sans-serif;color:#4A443B;font-size:16px;max-width:440px;margin:0 0 24px;line-height:1.55}\n.ink-craft__chips{display:flex;gap:10px;flex-wrap:wrap}\n.ink-craft__chips span{display:inline-flex;align-items:center;gap:7px;font-family:'Space Mono',monospace;font-size:11px;background:#ffffff;border:1px solid #E7D6C4;color:#C15F3C;padding:7px 13px;border-radius:30px;letter-spacing:.02em}\n.ink-craft__chips svg{width:15px;height:15px;flex:none}\n.ink-craft__link{display:inline-block;margin-top:24px;font-family:'Space Mono',ui-monospace,monospace;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#1A1A1A;text-decoration:none;border-bottom:1.5px solid currentColor;padding-bottom:3px;transition:opacity .2s ease}\n.ink-craft__link:hover{opacity:.65}\n.ink-craft__imgwrap{display:flex;align-items:center;justify-content:center;background:#f5efeb;min-height:440px;max-height:560px;overflow:hidden}\n.ink-craft__img{max-width:100%;max-height:100%;width:auto;height:auto;display:block}\n@media(max-width:749px){\n  .ink-craft{grid-template-columns:1fr}\n  .ink-craft__imgwrap{order:-1;min-height:260px;max-height:420px}\n  .ink-craft__text{padding:40px 24px}\n  .ink-craft__title{font-size:30px}\n}\n</style>"
      }
    },
