      "name": "Custom liquid: As Seen In",
      "settings": {
        "custom_liquid": "<div class=\"ink-press\">\n  <p class=\"ink-press__label\">as seen in</p>\n  <div class=\"ink-press__logos\">\n    <img src=\"https://inkkas.com/cdn/shop/files/logoELLE.png\" alt=\"ELLE\">\n    <img src=\"https://inkkas.com/cdn/shop/files/logoPEOPLE_ca9d198d-a31f-49b8-a157-724d0d969a17.png\" alt=\"People\">\n    <img src=\"https://inkkas.com/cdn/shop/files/logoGLAMOUR_43a9bbff-3be5-46d8-aeff-f4e990da8681.png\" alt=\"Glamour\">\n    <img src=\"https://inkkas.com/cdn/shop/files/logoWAPOST.png\" alt=\"Washington Post\">\n  </div>\n</div>\n<style>\n.ink-press{text-align:center;background:#;margin-top:28px;padding:22px 20px 26px}\n.ink-press__label{font-family:'Space Mono',ui-monospace,monospace;font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:#9A5738;margin:0 0 16px}\n.ink-press__logos{display:flex;justify-content:center;align-items:center;gap:clamp(24px,5vw,48px);flex-wrap:wrap}\n.ink-press__logos img{height:22px;width:auto;filter:grayscale(1);opacity:.55}\n@media(max-width:749px){\n  .ink-press{padding:18px 16px 20px}\n  .ink-press__logos{gap:22px 28px}\n  .ink-press__logos img{height:16px}\n}\n</style>"
