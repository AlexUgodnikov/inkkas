      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom liquid: Artful, Travel-Inspired Footwear",
      "settings": {
        "custom_liquid": "<section class=\"ink-values\">\n  <div class=\"ink-values__inner\">\n    <h2 class=\"ink-values__title\">Artful, Travel-Inspired Footwear</h2>\n    <p class=\"ink-values__subtitle\">For Everyday Adventures</p>\n    <div class=\"ink-values__badges\">\n      <img class=\"ink-values__badge\" src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/3_1.png?v=1779992083\" alt=\"Inked by artists — original artistry\" width=\"190\" height=\"190\" loading=\"lazy\">\n      <img class=\"ink-values__badge\" src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/1_1.png?v=1779992083\" alt=\"Over 10,000 5-star reviews\" width=\"190\" height=\"190\" loading=\"lazy\">\n      <img class=\"ink-values__badge\" src=\"https://cdn.shopify.com/s/files/1/0162/1490/files/5_1.png?v=1779992083\" alt=\"Global design — authentic textiles\" width=\"190\" height=\"190\" loading=\"lazy\">\n    </div>\n  </div>\n</section>\n<style>\n  .ink-values {\n    background: #f5efeb;\n    padding: 48px 20px;\n    text-align: center;\n  }\n  .ink-values__inner {\n    max-width: 820px;\n    margin: 0 auto;\n  }\n  .ink-values__title {\n    font-family: 'Fraunces', Georgia, serif;\n    font-weight: 600;\n    font-size: clamp(20px, 3vw, 36px);\n    line-height: 1.1;\n    color: #1a1a1a;\n    margin: 0;\n  }\n  .ink-values__subtitle {\n    font-family: 'Fraunces', Georgia, serif;\n    font-style: italic;\n    font-weight: 400;\n    font-size: clamp(18px, 2.6vw, 30px);\n    color: #1a1a1a;\n    margin: 4px 0 32px;\n  }\n  .ink-values__badges {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: clamp(12px, 3vw, 40px);\n    flex-wrap: wrap;\n  }\n  .ink-values__badge {\n    width: clamp(88px, 13vw, 132px);\n    height: auto;\n  }\n</style>"
      }
