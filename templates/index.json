      "settings": {
        "custom_liquid": "<div style=\"text-align:center; padding:5px 0 5px;\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs><filter id=\"ink-happy-sun\" x=\"-25%\" y=\"-25%\" width=\"150%\" height=\"150%\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.035\" numOctaves=\"2\" seed=\"4\" result=\"n\"/><feDisplacementMap in=\"SourceGraphic\" in2=\"n\" scale=\"2\" xChannelSelector=\"R\" yChannelSelector=\"G\"/></filter></defs></svg>\n  <p style=\"font-family:'Fraunces',Georgia,serif; font-size:24px; font-weight:600; letter-spacing:.01em; color:#1A1A1A; margin:0 0 4px;\">Color me <span style=\"color:#FFB715; display:inline-block; transform:skewX(-10deg);\">happy</span>.<svg viewBox=\"0 0 48 48\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"#FFB715\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-5px; margin-left:7px;\" filter=\"url(#ink-happy-sun)\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"7\"/><line x1=\"24\" y1=\"13\" x2=\"24\" y2=\"7\"/><line x1=\"24\" y1=\"35\" x2=\"24\" y2=\"41\"/><line x1=\"13\" y1=\"24\" x2=\"7\" y2=\"24\"/><line x1=\"35\" y1=\"24\" x2=\"41\" y2=\"24\"/><line x1=\"16.2\" y1=\"16.2\" x2=\"12.3\" y2=\"12.3\"/><line x1=\"31.8\" y1=\"16.2\" x2=\"35.7\" y2=\"12.3\"/><line x1=\"16.2\" y1=\"31.8\" x2=\"12.3\" y2=\"35.7\"/><line x1=\"31.8\" y1=\"31.8\" x2=\"35.7\" y2=\"35.7\"/></svg></p>\n  <p style=\"font-family:'Fraunces',Georgia,serif; font-size:18px; font-weight:500; letter-spacing:.01em; color:#C15F3C; margin:0;\">10,000+ 5-star reviews say it all</p>\n</div>"
