    "craft_custom": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom liquid: hand-inked",
      "settings": {
        "custom_liquid": "<div class=\"ink-craft\">\n  <div class=\"ink-craft__text\">\n    <p class=\"ink-craft__eyebrow\">since 2012</p>\n    <h2 class=\"ink-craft__title\">Hand-<em>inked</em> by artists.<br>Made to move <em>you.</em></h2>\n    <p class=\"ink-craft__body\">Every design starts as original art, inked by independent artists and inspired by nature around the world. Ethically handcrafted in small batches, better for people and the planet.</p>\n    <div class=\"ink-craft__chips\"><span>hand-inked art</span><span>small-batch craft</span><span>500k+ trees planted</span></div>\n  </div>\n  <div class=\"ink-craft__img\"></div>\n</div>\n<style>\n.ink-craft{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;background:#F7E3D8;overflow:hidden}\n.ink-craft__text{padding:60px 56px}\n.ink-craft__eyebrow{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#9A5738;margin:0 0 12px}\n.ink-craft__title{font-family:'Fraunces',Georgia,serif;font-weight:400;font-size:38px;line-height:1.05;color:#3A3A2F;margin:0 0 16px}\n.ink-craft__title em{font-style:italic;color:#C0517A}\n.ink-craft__body{color:#7C5748;font-size:16px;max-width:440px;margin:0 0 24px;line-height:1.55}\n.ink-craft__chips{display:flex;gap:10px;flex-wrap:wrap}\n.ink-craft__chips span{font-family:'Space Mono',monospace;font-size:11px;background:#FBEEE6;border:1px solid #E6C3B1;color:#9A5738;padding:7px 13px;border-radius:30px;letter-spacing:.02em}\n.ink-craft__img{min-height:440px;height:100%;background:center/cover no-repeat url('https://inkkas.com/cdn/shop/files/BLAKE-SLIP-ON-KL302333-MODELZOOM-ART-IMG_7673.jpg?v=1764879294')}\n@media(max-width:749px){.ink-craft{grid-template-columns:1fr}.ink-craft__img{min-height:280px;order:-1}.ink-craft__text{padding:40px 24px}.ink-craft__title{font-size:30px}}\n</style>"
      }
    },
