{% comment %}
  Inkkas redesign: values strip (replaces the uploaded seal images with a clean
  3-column text strip matching the PDP mockup). Original image-based version is in
  the untouched theme download if you ever want to revert.
{% endcomment %}
<div class="inkkas-values">
  <div class="inkkas-values__item">
    <span class="inkkas-values__eyebrow">hand-inked</span>
    <span class="inkkas-values__title">Original art by independent artists</span>
  </div>
  <div class="inkkas-values__item">
    <span class="inkkas-values__eyebrow">small-batch</span>
    <span class="inkkas-values__title">Ethically handcrafted since 2012</span>
  </div>
  <div class="inkkas-values__item">
    <span class="inkkas-values__eyebrow">500k+ trees</span>
    <span class="inkkas-values__title">One tree planted per pair</span>
  </div>
</div>

{% style %}
  .inkkas-values{
    display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
    background:var(--ink-green-soft,#E7EEDB);
    border-radius:14px;padding:20px 18px;margin:22px 0;text-align:center;
  }
  .inkkas-values__item{display:flex;flex-direction:column;gap:6px;}
  .inkkas-values__eyebrow{
    font-family:'Space Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.06em;
    text-transform:uppercase;color:var(--ink-green,#5E8A4C);
  }
  .inkkas-values__title{
    font-family:'Fraunces',Georgia,serif;font-size:13px;line-height:1.2;color:#34461F;
  }
  @media (max-width:600px){
    .inkkas-values{grid-template-columns:1fr;gap:14px;text-align:left;padding:20px;}
    .inkkas-values__item{flex-direction:row;align-items:baseline;gap:10px;}
    .inkkas-values__title{font-size:15px;}
  }
{% endstyle %}
